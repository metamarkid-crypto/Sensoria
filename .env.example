[TEMPLATE]
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="ISI_API_KEY_GOOGLE_MAPS_ANDA_DI_SINI"
EXPO_PUBLIC_GEMINI_API_KEY="ISI_API_KEY_GEMINI_ANDA_DI_SINI"
EXPO_PUBLIC_FISH_AUDIO_API_KEY="ISI_API_KEY_FISH_AUDIO_ANDA_DI_SINI"

# Custom Fish Audio Voice Models — Reference ID dari model suara custom Anda (WAJIB diisi)
# Dibaca langsung TANPA fallback oleh audioManager.ts.
# Ganti placeholder di bawah dengan reference_id asli model Fish Audio Anda.
EXPO_PUBLIC_VOICE_GIRL="ISI_REFERENCE_ID_VOICE_GIRL"
EXPO_PUBLIC_VOICE_GIRL_2="ISI_REFERENCE_ID_VOICE_GIRL_2"
EXPO_PUBLIC_VOICE_BOY="ISI_REFERENCE_ID_VOICE_BOY"
EXPO_PUBLIC_VOICE_BOY_2="ISI_REFERENCE_ID_VOICE_BOY_2"
EXPO_PUBLIC_VOICE_DAD="ISI_REFERENCE_ID_VOICE_DAD"
EXPO_PUBLIC_VOICE_MOM="ISI_REFERENCE_ID_VOICE_MOM"

# Shared HMAC secret for the qris-api backend (SAME value as QRIS_API_SECRET
# in qris-api/.env.production). Scanner filter only — real security is
# server-side pricing (blueprint QRIS_API §4.5).
EXPO_PUBLIC_QRIS_API_SECRET="ISI_RANDOM_SECRET_PANJANG_SAMA_DENGAN_QRIS_API"

# Optional: base URL of the qris-api service. Default is the live deployment
# (https://api.aacsensoria.id) — set this ONLY when the host changes.
EXPO_PUBLIC_QRIS_API_BASE_URL="https://api.aacsensoria.id"
