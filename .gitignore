# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
keystore-base64.txt
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit real keys
.env
.env*.local
.env.*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Next.js (admin dashboard)
.next/

# archives
*.zip

# Freebuff local tooling & runtime logs (machine-specific, never commit)
.freebuff/
dev-server.log

# go-merchant: local reverse-engineering sandbox for the GoPay/QRIS gateway.
# NOT part of the shipped product — it vendors 17 MB of Windows platform-tools
# binaries (adb.exe & co), runtime logs, and raw request dumps. The production
# payment service lives in qris-api/ instead.
go-merchant/

# One-off QA artifacts from the ARASAAC pictogram audits — regenerable via
# scripts/check-arasaac-urls.js, scripts/verify-arasaac-ids.js and
# scripts/download-umum-500.js (~5.7 MB of throwaway output).
scripts/*-report.json
scripts/*-review.html
scripts/arasaac-visual-check.html

# Backup copies of generated data (e.g. arasaac.json.bak.orig — the tracked
# original is always recoverable from git history).
*.orig

# VPS deploy session artifacts — temporary credentials & SSH keys, NEVER commit.
.vps-credentials.txt
.vps-key
.vps-key.pub
.vps-askpass.sh

# FCM config (CI writes it from the GOOGLE_SERVICES_JSON secret)
google-services.json

# Firebase service account private keys (FCM V1). File ini berisi private_key
# yang bisa mengirim push ke SEMUA perangkat app ini — tidak boleh masuk git.
# Pola `*adminsdk*.json` menangkap nama unduhan default dari Firebase Console
# (mis. <project>-firebase-adminsdk-xxxxx-yyyyyyyy.json).
*adminsdk*.json
*firebase-adminsdk*.json

