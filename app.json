{
  "expo": {
    "name": "Sensoria",
    "slug": "Sensoria",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E1F2FD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "id.sensoria.aac",
      "versionCode": 2,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2FAFE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B2545",
            "image": "./assets/splash-icon.png"
          },
          "android": {
            "backgroundColor": "#F2FAFE",
            "image": "./assets/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sensoria mengakses lokasi untuk memantau keberadaan anak.",
          "locationAlwaysAndWhenInUsePermission": "Sensoria mengakses lokasi di latar belakang agar orang tua tetap dapat memantau anak.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "sensoria-org",
          "project": "sensoria-aac"
        }
      ]
    ],
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "aa1cfb2b-48ce-46c5-8fed-8f170a7cb3d9"
      }
    }
  }
}
