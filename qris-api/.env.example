# ============================================================================
# qris-api — environment template. Copy to .env.production (chmod 600, NEVER
# committed). Locally copy to .env and fill in.
# ============================================================================

# --- Express ---------------------------------------------------------------
PORT=3200

# --- Supabase (service role — SERVER ONLY, never expose to any client) ------
# Same project the admin dashboard and mobile app use. The service role
# bypasses RLS: qris_merchants (GoBiz tokens) and qris_orders must never be
# reachable by any client.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ISI_SERVICE_ROLE_KEY

# --- Shared HMAC secret -----------------------------------------------------
# Signs mobile (/api/*) and dashboard (/internal/*) requests:
#   X-Sensoria-Timestamp = <unix seconds>
#   X-Sensoria-Sign      = HMAC-SHA256("<timestamp>.<rawBody>", QRIS_API_SECRET)  (hex)
# This is a scanner filter, not strong auth (the mobile secret ships in the
# APK) — real security is server-side amount/plan resolution, see blueprint §4.5.
QRIS_API_SECRET=ISI_RANDOM_SECRET_PANJANG
# Max allowed |server_time - timestamp| in seconds (replay-window).
QRIS_HMAC_MAX_SKEW=300

# --- Checkout path ----------------------------------------------------------
# IP rate limit for /api/qris-checkout + /api/qris-status (requests per window).
QRIS_RATE_WINDOW_MS=60000
QRIS_RATE_MAX=20
# Max orders per child device per 10 minutes (checkout abuse brake).
QRIS_MAX_OPEN_ORDERS=3

# --- Internal (dashboard server actions) ------------------------------------
# /internal/* uses the same HMAC signing; raw image uploads (qr-image) are
# capped at 8 MB by app.js and 5 MB by the decoder itself. An Nginx IP
# allowlist for /internal/* is the Fase-2 roadmap hardening step.

# --- Worker -----------------------------------------------------------------
# Cron pattern for the payment-detector worker (blueprint: 60 s). The worker
# runs inside the HTTP process by default; WORKER_DISABLED=1 + `node
# src/worker.js` splits it out (PM2 second app) when needed.
WORKER_CRON=*/30 * * * * *
WORKER_DISABLED=0
# Pending orders older than this are expired (order → 'expired', ledger → 'failed').
QRIS_CHECKOUT_TTL_MINUTES=15
# Max orders expired per sweep (backlog brake).
WORKER_EXPIRE_BATCH=200
# Only merchants with live PENDING orders are polled (smart selection). Enable
# only for debugging — polling without PENDING invites GoBiz rate flags.
WORKER_POLL_ALL_MERCHANTS=false

# --- Debugging --------------------------------------------------------------
# 1 = log GoBiz request/response shapes (token fields redacted). Never enable
# in production beyond a short incident window.
QRIS_DEBUG=0
