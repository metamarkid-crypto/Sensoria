[TEMPLATE]
# ============================================================================
# qris-api — environment template. Copy to .env.production (chmod 600, NEVER
# committed). Locally copy to .env and fill in.
# ============================================================================

# --- Express ---------------------------------------------------------------
PORT=3200

# --- Supabase (service role — SERVER ONLY, never expose to any client) ------
# Same project the admin dashboard and mobile app use. The service role
# bypasses RLS: qris_merchants (GoBiz tokens) and qris_orders must never be
# reachable by any client.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ISI_SERVICE_ROLE_KEY

# --- Mobile HMAC secret ------------------------------------------------------
# Signs mobile (/api/*) requests ONLY:
#   X-Sensoria-Timestamp = <unix seconds>
#   X-Sensoria-Sign      = HMAC-SHA256("<timestamp>.<rawBody>", QRIS_API_SECRET)  (hex)
# This is a scanner filter, not strong auth (the mobile secret ships in the
# APK) — real security is server-side amount/plan resolution, see blueprint §4.5.
QRIS_API_SECRET=ISI_RANDOM_SECRET_PANJANG
# Max allowed |server_time - timestamp| in seconds (replay-window).
QRIS_HMAC_MAX_SKEW=300

# --- Checkout path ----------------------------------------------------------
# IP rate limit for /api/qris-checkout + /api/qris-status + /api/checkout-session
# + /api/webhook/toyyibpay (requests per window).
QRIS_RATE_WINDOW_MS=60000
QRIS_RATE_MAX=20
# Max orders per child device per 10 minutes (checkout abuse brake).
QRIS_MAX_OPEN_ORDERS=3

# --- Internal (dashboard server actions) ------------------------------------
# HARDENING C-4 — a SEPARATE secret for /internal/*. These routes can replace
# the static QRIS payload (redirecting all customer payments), so they must
# NOT be verifiable with the APK-embedded QRIS_API_SECRET.
#   • Must be a DIFFERENT random value from QRIS_API_SECRET.
#   • Set the SAME value in admin/.env.local as QRIS_INTERNAL_SECRET.
#   • If unset, the service falls back to QRIS_API_SECRET and logs a loud
#     security warning at boot.
QRIS_INTERNAL_SECRET=ISI_RANDOM_SECRET_LAIN
# OPTIONAL IP allowlist for /internal/* (comma-separated). Unset/empty → the
# check is skipped (the separate HMAC secret is the real gate). Only set this
# when the dashboard host IP is known, e.g. QRIS_INTERNAL_ALLOWLIST=127.0.0.1,10.0.0.5
# Do NOT set a loopback-only default on a single-server deployment: the
# dashboard calls https://app.aacsensoria.id and hairpins back via the server's
# public IP, which a loopback list would wrongly reject.
QRIS_INTERNAL_ALLOWLIST=
# Raw image uploads (qr-image) are capped at 8 MB by app.js and 5 MB by the
# decoder itself.

# --- Worker -----------------------------------------------------------------
# Cron pattern for the payment-detector worker (blueprint: 60 s). The worker
# runs inside the HTTP process by default; WORKER_DISABLED=1 + `node
# src/worker.js` splits it out (PM2 second app) when needed.
WORKER_CRON=*/30 * * * * *
WORKER_DISABLED=0
# Pending orders older than this are expired (order → 'expired', ledger → 'failed').
QRIS_CHECKOUT_TTL_MINUTES=15
# Max orders expired per sweep (backlog brake).
WORKER_EXPIRE_BATCH=200
# Only merchants with live PENDING orders are polled (smart selection). Enable
# only for debugging — polling without PENDING invites GoBiz rate flags.
WORKER_POLL_ALL_MERCHANTS=false

# --- Browser checkout (multi-provider: QRIS ID + toyyibPay MY) --------------
# Secret for the signed browser-checkout tokens (/pay/:token). Use a DIFFERENT
# random value from QRIS_API_SECRET / QRIS_INTERNAL_SECRET. Falls back to
# QRIS_INTERNAL_SECRET → QRIS_API_SECRET when unset (with a loud warning).
PAY_CHECKOUT_TOKEN_SECRET=ISI_RANDOM_SECRET_LAIN_LAGI
# Public origin of THIS service — builds absolute gateway callback URLs.
PAY_WEBHOOK_BASE_URL=https://app.aacsensoria.id
# Public origin used for the bill RETURN redirect back to our status page.
PAY_PAGE_BASE_URL=https://app.aacsensoria.id

# --- toyyibPay (Malaysia: FPX + Card + DuitNow QR) --------------------------
# From the toyyibPay dashboard (Account Settings → Secret Key). Sandbox:
# register at https://dev.toyyibpay.com and set TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://toyyibpay.com
# Enable the DuitNow QR channel on bills (account must have DuitNow QR active).
# Set 0 to disable (FPX + card only).
TOYYIBPAY_DUITNOW=1
# Poller for MY orders whose callback has not arrived: cron + disable flag.
TP_POLL_CRON=*/30 * * * * *
TP_POLL_DISABLED=0

# --- Debugging --------------------------------------------------------------
# 1 = log GoBiz request/response shapes (token fields redacted). Never enable
# in production beyond a short incident window.
QRIS_DEBUG=0
